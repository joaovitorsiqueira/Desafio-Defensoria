# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.
# Nunca coloque chaves reais neste arquivo (.env.example) nem versione o seu ".env".

# Provedor de IA. Suportados: "ollama" (modelo local, padrão) ou "anthropic".
AI_PROVIDER=ollama

# Modelo usado para a extração estruturada.
# - Com AI_PROVIDER=ollama: nome do modelo já baixado no Ollama, ex. "qwen3:8b".
# - Com AI_PROVIDER=anthropic: "claude-sonnet-5" (padrão), "claude-opus-5" (mais
#   caro/capaz) ou "claude-haiku-4-5" (mais barato/simples).
# Ver DECISOES.md para a justificativa da escolha do modelo padrão.
AI_MODEL=qwen3:8b

# --- Configuração específica do provedor "ollama" ---
# Endereço do servidor Ollama local (rode `ollama serve` e `ollama pull qwen3:8b`
# antes de usar). Ver README.md para instruções completas.
OLLAMA_BASE_URL=http://localhost:11434
# Contexto (em tokens) pedido ao Ollama por requisição.
OLLAMA_NUM_CTX=16384
# Ativa o modo de raciocínio interno do Qwen3 (mais lento; não necessário para
# extração estruturada nos testes deste projeto).
OLLAMA_THINK=false

# --- Configuração específica do provedor "anthropic" ---
# Chave de API da Anthropic (https://console.anthropic.com/). Só é necessária se
# AI_PROVIDER=anthropic. Sem ela a aplicação sobe normalmente, mas o
# processamento retorna um erro amigável ao tentar chamar o modelo.
ANTHROPIC_API_KEY=

# String de conexão do banco. SQLite por padrão (arquivo local, sem servidor).
DATABASE_URL=sqlite:///./backend/storage/atos.db

# Limites de upload/entrada.
MAX_UPLOAD_MB=15
MAX_TEXT_CHARS=200000

# Estratégia para documentos longos: acima deste número de caracteres, o texto é
# truncado (cabeçalho + trecho final) antes de ser enviado ao modelo. Ver
# DECISOES.md, seção "Documentos longos".
SEGMENTATION_MAX_CHARS=24000
SEGMENTATION_HEAD_RATIO=0.7

# Versão do prompt em uso (arquivo correspondente em prompts/<valor>.txt).
PROMPT_VERSION=extraction_v1

# Número máximo de tentativas ao chamar o modelo antes de desistir com erro
# controlado (recuperação de erros — seção 22 do desafio).
AI_MAX_ATTEMPTS=2

# Timeout (segundos) por tentativa de chamada ao modelo. Modelos locais em
# documentos longos podem levar vários minutos em hardware modesto — um
# despacho de 72 páginas levou ~4,3 minutos em testes reais.
AI_REQUEST_TIMEOUT_SECONDS=600
